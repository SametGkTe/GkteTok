    private View splashPage() {
        Page page = new Page(I18n.get(S.SPLASH_OPTIONS), false);
        page.section(I18n.get(S.SPLASH_HOLD));
        LinearLayout durations = page.card();
        final int[] values = {600, 900, 1100, 1500, 2000, 3000};
        final List<ImageView> durationChecks = new ArrayList<>();
        final List<ImageView> animChecks = new ArrayList<>();
        final String[] animIds = {"fade", "zoom", "slide", "none"};
        final S[] animTitles = {S.ANIM_FADE, S.ANIM_ZOOM, S.ANIM_SLIDE, S.ANIM_NONE};
        Runnable[] refresh = new Runnable[1];
        for (int value : values) {
            final int chosen = value;
            durationChecks.add(selectableRow(durations, String.format(locale, "%d ms", value),
                    Prefs.splashMs() == value, () -> {
                        Prefs.setSplashMs(chosen);
                        refresh[0].run();
                    }));
        }
        page.section(I18n.get(S.SPLASH_ANIM));
        LinearLayout animations = page.card();
        for (int index = 0; index < animIds.length; index++) {
            final String id = animIds[index];
            animChecks.add(selectableRow(animations, I18n.get(animTitles[index]),
                    id.equals(Prefs.splashAnim()), () -> {
                        Prefs.setSplashAnim(id);
                        refresh[0].run();
                    }));
        }
        refresh[0] = () -> {
            for (int i = 0; i < values.length; i++) {
                durationChecks.get(i).setVisibility(Prefs.splashMs() == values[i] ? View.VISIBLE : View.INVISIBLE);
            }
            for (int i = 0; i < animIds.length; i++) {
                animChecks.get(i).setVisibility(animIds[i].equals(Prefs.splashAnim()) ? View.VISIBLE : View.INVISIBLE);
            }
        };
        return page.root;
    }

    private View chartPage() {
        Page page = new Page(I18n.get(S.COUNTER_CHART), false);
        int[] days = Stats.lastDays(7);
        int max = 1;
        for (int value : days) max = Math.max(max, value);
        LinearLayout card = page.card();
        LinearLayout chart = new LinearLayout(this);
        chart.setOrientation(LinearLayout.HORIZONTAL);
        chart.setGravity(Gravity.BOTTOM);
        int barMax = dp(120);
        for (int index = 0; index < days.length; index++) {
            LinearLayout column = new LinearLayout(this);
            column.setOrientation(LinearLayout.VERTICAL);
            column.setGravity(Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL);
            View bar = new View(this);
            bar.setBackground(rounded(palette.accent, dp(3)));
            int height = Math.max(dp(3), (int) ((long) barMax * days[index] / max));
            column.addView(bar, new LinearLayout.LayoutParams(dp(18), height));
            TextView count = new TextView(this);
            count.setText(String.valueOf(days[index]));
            count.setTextColor(palette.textSecondary);
            count.setTextSize(11);
            column.addView(count);
            TextView label = new TextView(this);
            label.setText(index == days.length - 1 ? I18n.get(S.COUNTER_TODAY) : "-" + (days.length - 1 - index));
            label.setTextColor(palette.textSecondary);
            label.setTextSize(11);
            column.addView(label);
            LinearLayout.LayoutParams columnParams = new LinearLayout.LayoutParams(0, -2, 1);
            columnParams.setMargins(dp(4), dp(10), dp(4), dp(10));
            chart.addView(column, columnParams);
        }
        card.addView(chart, new LinearLayout.LayoutParams(-1, -2));
        page.footer(I18n.get(S.CHART_CAPTION));
        return page.root;
    }

    private View healthPage() {
        Page page = new Page(I18n.get(S.SECTION_HEALTH), false);
        page.section(I18n.get(S.HEALTH_HOOKS));
        LinearLayout hooks = page.card();
        java.util.Map<String, String> statuses = Health.statuses();
        if (statuses.isEmpty()) {
            LinearLayout empty = row(hooks);
            texts(empty, I18n.get(S.HEALTH_NONE), null);
            empty.setClickable(false);
            empty.setBackground(null);
        }
        for (java.util.Map.Entry<String, String> entry : statuses.entrySet()) {
            boolean ok = Health.ok(entry.getValue());
            LinearLayout line = row(hooks);
            texts(line, entry.getKey(), ok ? null : Health.detail(entry.getValue()));
            TextView mark = new TextView(this);
            mark.setText(ok ? "\u2705" : "\u274C");
            mark.setTextSize(15);
            line.addView(mark, new LinearLayout.LayoutParams(-2, -2));
            line.setClickable(false);
            line.setBackground(null);
        }
        page.section(I18n.get(S.HEALTH_LOG));
        LinearLayout logcard = page.card();
        List<String> lines = Health.lines();
        if (lines.isEmpty()) {
            LinearLayout empty = row(logcard);
            texts(empty, I18n.get(S.HEALTH_NONE), null);
            empty.setClickable(false);
            empty.setBackground(null);
        }
        int from = Math.max(0, lines.size() - 14);
        for (int index = from; index < lines.size(); index++) {
            TextView line = new TextView(this);
            line.setText(lines.get(index));
            line.setTextColor(palette.textSecondary);
            line.setTextSize(12);
            line.setPadding(dp(16), dp(3), dp(16), dp(3));
            logcard.addView(line);
        }
        page.section(I18n.get(S.HEALTH_REPORT));
        LinearLayout report = page.card();
        navigation(report, I18n.get(S.HEALTH_REPORT), null,
                view -> pick(REQ_REPORT, Intent.ACTION_CREATE_DOCUMENT, "text/plain"));
        return page.root;
    }

    private View profilesPage() {
        Page page = new Page(I18n.get(S.SECTION_PROFILES), false);
        page.footer(I18n.get(S.PROFILES_DESC));
        String[] keys = {Prefs.PROFILE_1, Prefs.PROFILE_2, Prefs.PROFILE_3};
        for (int index = 0; index < keys.length; index++) {
            final String key = keys[index];
            final int number = index + 1;
            LinearLayout card = page.card();
            String saved = Prefs.rawString(key);
            final TextView[] saveRef = new TextView[1];
            saveRef[0] = navigation(card, I18n.get(S.PROFILE_SAVE) + " " + number,
                    saved.isEmpty() ? I18n.get(S.PROFILE_EMPTY) : dateLabel(parseLong(Prefs.rawString(key + "_time"))),
                    view -> {
                        Prefs.setRawString(key, Backup.encode());
                        Prefs.setRawString(key + "_time", String.valueOf(System.currentTimeMillis()));
                        saveRef[0].setText(dateLabel(System.currentTimeMillis()));
                        toast(I18n.get(S.PROFILE_SAVED));
                    });
            navigation(card, I18n.get(S.PROFILE_APPLY) + " " + number, null, view -> {
                String data = Prefs.rawString(key);
                if (data.isEmpty()) {
                    toast(I18n.get(S.PROFILE_EMPTY));
                    return;
                }
                int applied = Backup.apply(data);
                toast(I18n.get(applied > 0 ? S.PROFILE_APPLIED : S.BACKUP_FAILED));
            });
        }
        LinearLayout bottom = page.card();
        navigation(bottom, I18n.get(S.PROFILE_DELETE_ALL), null, view -> {
            for (String key : keys) {
                Prefs.setRawString(key, "");
                Prefs.setRawString(key + "_time", "");
            }
            toast(I18n.get(S.SAVED));
        });
        navigation(bottom, I18n.get(S.FACTORY_RESET), null, view -> {
            Backup.factoryReset();
            toast(I18n.get(S.SAVED));
        });
        return page.root;
    }

    private static long parseLong(String value) {
        try {
            return Long.parseLong(value);
        } catch (Throwable invalid) {
            return 0L;
        }
    }

