        accentChoice(card, S.ACCENT_PURPLE, "purple");
        accentChoice(card, S.ACCENT_GREEN, "green");
        accentChoice(card, S.ACCENT_GOLD, "gold");
        accentChoice(card, S.ACCENT_BLUE, "blue");
