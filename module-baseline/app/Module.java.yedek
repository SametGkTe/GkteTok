package com.golda.patchertiktok;

import android.app.Application;
import android.content.Context;

import java.lang.reflect.Method;
import java.lang.reflect.Modifier;
import java.util.concurrent.atomic.AtomicBoolean;

/** Everything the module does once TikTok's classes are available, for either entry point. */
final class Module {
    private static final String[] TARGETS = {"com.zhiliaoapp.musically", "com.ss.android.ugc.trill"};
    private static final AtomicBoolean LOADED = new AtomicBoolean();
    private static final AtomicBoolean STARTED = new AtomicBoolean();

    private Module() { }

    static boolean targets(String packageName) {
        return TARGETS[0].equals(packageName) || TARGETS[1].equals(packageName);
    }

    static void load(String packageName, String processName, ClassLoader loader) {
        if (!targets(packageName) || !LOADED.compareAndSet(false, true)) return;
        boolean main = packageName.equals(processName);

        if (main) {
            // These hooks read their toggle on every call, so they are safe before settings load.
            run("feed filter", () -> FeedFilter.install(loader));
            run("LIVE button", () -> LiveButton.install(loader));
            run("downloads", () -> Downloads.install(loader));
            run("clean links", CleanLinks::install);
            run("rendered ads", () -> RenderedAdSkip.install(loader));
            run("likes guard", () -> LikeGuard.install(loader));
            run("current video", () -> CurrentAweme.install(loader));
            run("download plus", () -> DownloadPlus.install(loader));
            run("post date", () -> PostDate.install(loader));
            run("dm filter", DmFilter::install);
            run("download name", () -> DownloadName.install(loader));
            run("fast open", () -> FastOpen.install(loader));
            run("google login", () -> googleLoginFix(loader));
        }
        // Every process: the settings screen and the restart trampoline are swapped in here.
        run("settings host", SettingsEntry::installHost);

        // TT+ — AMOLED: renk kancaları framework seviyesinde olduğu için kullanıcı
        // arayüzünün çizildiği her süreçte kurulmalı. Toggle her çağrıda okunur,
        // bu yüzden ayarlar yüklenmeden önce kurulması güvenlidir.
        run("TT+ AMOLED", Amoled::install);
        run("TT+ accent", AccentTheme::install);
        run("TT+ font", FontOverride::install);
        run("startup triggers", () -> startupTriggers(loader, main));
        RuntimeLog.log("hooks installed in " + processName + " (main=" + main + ")");
    }

    /**
     * Modül, Application hazır olduğunu hangi yoldan öğrenirse öğrensin startup bir kez çalışsın.
     *
     * LSPosed modülü süreç fork'undan ÖNCE yükler → Application.attach kancası yeterlidir.
     * LSPatch ise modülü ÇALIŞAN uygulamanın içine yükler: attach zaten çalışmış olabilir ve
     * Application.attach gizli (hidden) bir metottur, orada çözümlenemeyebilir. Bu yüzden
     * onCreate / attachBaseContext kancaları ve "uygulama hazırsa hemen başlat" kontrolü var.
     */
    private static void startupTriggers(ClassLoader loader, boolean main) {
        Hooks.Hook trigger = new Hooks.Hook() {
            @Override protected void after(Hooks.Call param) {
                if (param.thisObject instanceof Application) start((Application) param.thisObject, loader, main);
            }
        };
        run("attach trigger", () -> Hooks.findAndHook(Application.class, "attach", Context.class, trigger));
        run("attachBaseContext trigger", () -> Hooks.findAndHook(Application.class, "attachBaseContext", Context.class, trigger));
        run("onCreate trigger", () -> Hooks.findAndHook(Application.class, "onCreate", trigger));
        // LSPatch: modül yüklenirken uygulama zaten hazır olabilir — beklemeden başlat.
        run("immediate start", () -> {
            Application ready = currentApplication();
            if (ready != null) start(ready, loader, main);
        });
    }

    private static void start(Application app, ClassLoader loader, boolean main) {
        if (app == null || !STARTED.compareAndSet(false, true)) return;
        startup(app, loader, main);
    }

    private static Application currentApplication() {
        try {
            return (Application) Class.forName("android.app.ActivityThread")
                    .getMethod("currentApplication").invoke(null);
        } catch (Throwable error) {
            return null;
        }
    }

    /** Runs once the Application context exists, before TikTok's own onCreate. */
    private static void startup(Application app, ClassLoader loader, boolean main) {
        try {
            Prefs.load(app);
            Stats.attach(app);
            Health.startup(BuildConfig.VERSION_NAME, app.getPackageName());
            if (main) Stats.countOpen();
            run("region", () -> RegionSpoof.install(loader));
            if (RegionSpoof.active()) run("recommendation", () -> Recommendation.install(loader));
            I18n.use(app.getResources().getConfiguration().getLocales().get(0));
            run("font scale", () -> FontScale.install(app));
            if (!main) {
                RuntimeLog.log(BuildConfig.VERSION_NAME + " started (secondary process)");
                return;
            }
            RuntimeLog.log("code tag GKTETOK-V9");
            Discovery.init(app);
            run("A/B overrides", () -> AbOverrides.install(loader));
            run("startup ads", () -> StartupAds.install(loader));
            run("seekbar", () -> Seekbar.install(loader));
            run("settings row", () -> SettingsEntry.install(app, loader));
            run("gkte splash", () -> LaunchSplash.install(app));
            run("auto streaks", () -> AutoStreakManager.install(app, loader));
            run("time limit", () -> TimeLimit.install(app));
            run("daily summary", () -> Summary.install(app));
            run("summary check", () -> Summary.maybePost(app));
            run("kill switch", () -> KillSwitch.install(app, loader));
            Discovery.release();
            RuntimeLog.log(BuildConfig.VERSION_NAME + " started in " + app.getPackageName());
        } catch (Throwable error) {
            RuntimeLog.log("startup failed: " + error);
        }
    }

    private static void run(String name, Runnable task) {
        try {
            task.run();
            Health.record(name, true, null);
        } catch (Throwable error) {
            Health.record(name, false, error.getClass().getSimpleName());
            RuntimeLog.log(name + " unavailable: " + error);
        }
    }

    /** TikTok's Google sign-in breaks on devices it considers modified; keep the standard flow. */
    private static void googleLoginFix(ClassLoader loader) {
        for (String name : new String[]{"com.bytedance.lobby.google.GoogleAuth", "com.bytedance.lobby.google.GoogleOneTapAuth"}) {
            Class<?> type = Hooks.findClass(name, loader);
            if (type == null) continue;
            for (Method method : type.getDeclaredMethods()) {
                if (method.getParameterTypes().length == 0 && method.getReturnType() == boolean.class
                        && Modifier.isFinal(method.getModifiers()) && Modifier.isPublic(method.getModifiers())) {
                    Hooks.hook(method, Hooks.constant(false));
                }
            }
        }
    }
}
